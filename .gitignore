# =============================================================
# SERVICE LAYER TODO CHECKLIST
# =============================================================
#
# GENERAL RULES FOR EACH SERVICE:
#   - Annotate with @Service
#   - Inject repository via constructor (not @Autowired field)
#   - Map request DTO -> entity before saving
#   - Map entity -> response DTO before returning
#   - Throw RuntimeException (or custom exception) if entity not found
#
# -------------------------------------------------------------
# [x] UserService
#       [x] createUser(CreateUserRequest) -> UserResponse
#       [x] getAllUsers() -> List<UserResponse>
#       [x] getUserById(Long id) -> UserResponse
#       [x] deleteUser(Long id) -> void
#
# [ ] AuthService
#       [ ] login(LoginRequest) -> UserResponse
#             - findByUserName, verify password, return user
#
# [x] IngredientService
#       [x] createIngredient(CreateIngredientRequest) -> IngredientResponse
#       [x] getAllIngredients() -> List<IngredientResponse>
#       [x] getIngredientById(Long id) -> IngredientResponse
#       [x] updateIngredient(Long id, UpdateIngredientRequest) -> IngredientResponse
#       [x] deleteIngredient(Long id) -> void
#
# [ ] RecipeService
#       [x] createRecipe(CreateRecipeRequest) -> RecipeResponse
#             - save Recipe first, then save each RecipeIngredient
#       [x] getAllRecipes() -> List<RecipeResponse>
#       [x] getRecipeById(Long id) -> RecipeResponse
#       [x] updateRecipe(Long id, UpdateRecipeRequest) -> RecipeResponse
#             - delete old RecipeIngredients, save new ones
#       [x] deleteRecipe(Long id) -> void
#
# [ ] ItemService
#       [x] createItem(CreateItemRequest) -> ItemResponse
#             - look up Recipe by recipeId before saving
#       [x] getAllItems() -> List<ItemResponse>
#       [x] getItemById(Long id) -> ItemResponse
#       [x] updateItem(Long id, UpdateItemRequest) -> ItemResponse
#       [x] deleteItem(Long id) -> void
#
# [x] InventoryService
#       [x] createInventory(CreateInventoryRequest) -> InventoryResponse
#             - look up Ingredient by ingredientId before saving
#       [x] getAllInventory() -> List<InventoryResponse>
#       [x] getInventoryById(Long id) -> InventoryResponse
#       [x] updateInventory(Long id, UpdateInventoryRequest) -> InventoryResponse
#       [x] getLowStockItems() -> List<InventoryResponse>
#             - filter where quantity <= threshold, set lowStock = true
#
# [x] TimeSheetService
#       [x] clockIn(ClockInRequest) -> TimeSheetResponse
#             - create entry with current date and clockIn time
#       [x] clockOut(Long timesheetId) -> TimeSheetResponse
#             - set clockOut time, calculate hoursWorked
#       [x] getTimesheetsByUser(Long userId) -> List<TimeSheetResponse>
#       [x] getAllTimesheets() -> List<TimeSheetResponse>
#
# =============================================================

